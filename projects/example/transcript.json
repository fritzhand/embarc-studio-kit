 "sentences": [
  {
   "id": "S1",
   "start": 0.433,
   "end": 3.618,
   "text": "I'm Sam Rivera and I'm the founder of Example Co."
  },
  {
   "id": "S2",
   "start": 6.009,
   "end": 10.751,
   "text": "Before this, I spent six years running the front desk at a busy dental clinic."
  },
  {
   "id": "S3",
   "start": 13.142,
   "end": 18.748,
   "text": "Example Co. is a scheduling app that fills last-minute cancellations for dental clinics."
  },
  {
   "id": "S4",
   "start": 19.351,
   "end": 24.605,
   "text": "When a patient cancels, we text the waiting list and book the first person who says yes."
  },
  {
   "id": "S5",
   "start": 27.005,
   "end": 32.544,
   "text": "I started it because I watched empty chairs cost our clinic real money every single week."
  },
  {
   "id": "S6",
   "start": 34.939,
   "end": 39.989,
   "text": "It's for clinic managers, the people who spend their mornings on the phone trying to fill a gap."
  },
  {
   "id": "S7",
   "start": 42.353,
   "end": 47.438,
   "text": "With Example Co., that gap fills itself and the manager gets their morning back."
  },
  {
   "id": "S8",
   "start": 49.813,
   "end": 53.615,
   "text": "If you run a clinic, try it for a month and count the chairs you fill."
  }
 ],
